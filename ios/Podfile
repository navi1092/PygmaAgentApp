# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Pygma' do
  # Xcode 17 reports hundreds of duplicate deprecation/documentation warnings
  # from React Native and other third-party Pod sources. Keep warnings enabled
  # for the Pygma app target while treating installed dependencies as external.
  inhibit_all_warnings!

  config = use_native_modules!

  # The package is already used by the Android app. Its iOS module uses the
  # External Accessory framework to communicate with compatible receipt
  # printers, but this older package needs an explicit Pod entry.

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'PygmaTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Several React Native archives intentionally contain platform-specific
    # object files with no global symbols. Newer libtool versions report each
    # one even though the archive is valid.
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |build_config|
        build_config.build_settings['OTHER_LIBTOOLFLAGS'] = '$(inherited) -no_warning_for_no_symbols'
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
      end
      pod_target.shell_script_build_phases.each do |script_phase|
        if ['[CP-User] [Hermes] Replace Hermes for the right configuration, if needed',
            '[CP-User] [RN]Check rncore'].include?(script_phase.name)
          script_phase.always_out_of_date = '1'
        end
      end
    end
  end
end
